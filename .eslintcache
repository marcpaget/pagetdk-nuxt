= computed(() => {\n    if (coords.value.speed) {\n        if (coords.value.speed > maxSpeed) {\n            maxSpeed = coords.value.speed\n        }\n        return (maxSpeed * 3.6).toFixed(2)\n    }\n    return 0\n})",[1433,1437],[1463,1471],[1508,1520],[1549,1549],[1550,1558],[1560,1568],[1602,1602],[1603,1607],[1609,1613],[1621,1621],[1624,1624],[1727,1727],[1728,1906],"const distancekm = computed(() => {\n    if (coords.value.speed) {\n        distance = distance + coords.value.speed\n        return (distance / 1000).toFixed(2)\n    }\n    return 0\n})",[1762,1766],[1792,1800],[1840,1840],[1841,1849],[1884,1884],[1885,1889],[1891,1895],[1903,1903],[1906,1906],[1929,1933],[2608,2612],[2725,2733],[2762,2774],[2798,2798],[2803,2803],[2810,2822],[2846,2846],[2860,2860],[2867,2879],[2902,2902],[2906,2906],[2913,2921],[2928,2936],[2965,2977],[3001,3001],[3011,3011],[3018,3030],[3054,3054],[3071,3071],[3078,3090],[3113,3113],[3117,3117],[3124,3132],[3139,3147],[3176,3188],[3212,3212],[3222,3222],[3229,3241],[3265,3265],[3279,3279],[3286,3298],[3321,3321],[3325,3325],[3332,3340],[3347,3355],[3384,3396],[3420,3420],[3428,3428],[3435,3447],[3471,3471],[3487,3487],[3494,3506],[3529,3529],[3533,3533],[3540,3548],[3555,3563],[3592,3604],[3628,3628],[3644,3644],[3651,3663],[3687,3687],[3701,3701],[3708,3720],[3743,3743],[3749,3749],[3756,3764],[3771,3779],[3808,3820],[3844,3844],[3861,3861],[3868,3880],[3904,3904],[3926,3926],[3933,3945],[3968,3968],[3974,3974],[3981,3989],[3996,4004],[4033,4045],[4069,4069],[4076,4076],[4083,4095],[4119,4119],[4132,4132],[4139,4151],[4177,4185],[4192,4200],[4229,4241],[4265,4265],[4273,4273],[4280,4292],[4316,4316],[4330,4330],[4337,4349],[4375,4387],[4414,4430],[4468,4469],[4485,4485],[4496,4496],[4506,4522],[4549,4569],[4595,4596],[4611,4611],[4622,4622],[4632,4648],[4655,4667],[4674,4682],[4689,4693],[11,15],[46,47],[140,144],[158,166],[177,181],[185,189],[202,210],[220,232],[242,250],[253,261],[270,282],[324,332],[335,343],[352,364],[39